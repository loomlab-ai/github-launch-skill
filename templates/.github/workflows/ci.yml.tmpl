# Minimal CI. Delete the Node, Python, Go, and Rust steps that do not match this repo.
# A hand-written site under docs/ does not need a Pages deploy job.
# ${{ }} below is GitHub Actions syntax, not a github-launch placeholder.
name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Required files
        run: |
          test -f README.md
          test -f LICENSE

      - name: Node
        if: ${{ hashFiles('package.json') != '' }}
        run: |
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm test --if-present

      - name: Python
        if: ${{ hashFiles('pyproject.toml', 'requirements.txt', 'setup.py') != '' }}
        run: |
          python -m pip install -U pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          if [ -d tests ] || compgen -G 'test_*.py' >/dev/null; then
            if python -c 'import pytest' >/dev/null 2>&1; then
              python -m pytest -q
            else
              python -m unittest discover -q
            fi
          else
            echo "No Python tests found"
          fi

      - name: Go
        if: ${{ hashFiles('go.mod') != '' }}
        run: go test ./...

      - name: Rust
        if: ${{ hashFiles('Cargo.toml') != '' }}
        run: cargo test
